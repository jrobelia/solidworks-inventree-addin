# ===========================================
# SolidWorks InvenTree Add-In  .gitignore
# ===========================================

# --- SECURITY: Server config contains real API keys — NEVER commit ---
inventree_servers.json

# --- Company-internal reference files — not for public release ---
docs/reference/
Reference/
docs/research/
docs/screenshots/
docs/superpowers/
docs/archive/

# --- Scratch / debug output — never commit ---
inventree_debug.log
test_results.txt
.scratch/

# --- Packaged installer zips (generated by Package.ps1) ---
Installer/*.zip

# --- .NET / Visual Studio build outputs ---
bin/
obj/
bin_unit_test/
*.user
*.suo
.vs/
*.DotSettings.user

# --- NuGet packages ---
packages/
*.nupkg

# --- Windows ---
Thumbs.db
Desktop.ini

# --- VS Code ---
.vscode/

# Git worktrees
.worktrees/

# --- Devin config (personal overrides and project config are not shared) ---
.devin/config.json
.devin/config.local.json
