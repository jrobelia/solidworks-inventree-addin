# ===========================================
# SolidWorks InvenTree Add-In  .gitignore
# ===========================================

# --- SECURITY: Server config contains real API keys — NEVER commit ---
inventree_servers.json

# --- Company-internal reference files — not for public release ---
docs/reference/
Reference/
docs/research/
docs/screenshots/
docs/superpowers/

# --- Scratch / debug output — never commit ---
inventree_debug.log
.scratch/

# --- Packaged installer zips (generated by Package.ps1) ---
Installer/*.zip

# --- .NET / Visual Studio build outputs ---
bin/
obj/
*.user
*.suo
.vs/
*.DotSettings.user

# --- NuGet packages ---
packages/
*.nupkg

# --- Windows ---
Thumbs.db
Desktop.ini

# --- VS Code ---
.vscode/

# Git worktrees
.worktrees/
