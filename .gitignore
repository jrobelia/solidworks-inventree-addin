# ===========================================
# SolidWorks InvenTree Add-In  .gitignore
# ===========================================

# --- SECURITY: Server config contains real API keys — NEVER commit ---
inventree_servers.json

# --- Scratch / debug output — never commit ---
inventree_debug.log
_scratch/

# --- Packaged installer zips (generated by Package.ps1) ---
Installer/*.zip

# --- .NET / Visual Studio build outputs ---
bin/
obj/
*.user
*.suo
.vs/
*.DotSettings.user

# --- NuGet packages ---
packages/
*.nupkg

# --- Windows ---
Thumbs.db
Desktop.ini

# --- VS Code ---
.vscode/
