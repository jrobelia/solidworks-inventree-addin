<Window
    x:Class="SwInventreeAddin.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="InvenTree Settings"
    Width="480"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    FontFamily="Segoe UI"
    FontSize="12">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel>

        <!-- Blue accent stripe -->
        <Border Height="4" Background="{StaticResource BrushAccentBlue}" />

        <StackPanel Margin="16,14,16,16">

            <TextBlock Text="Server URL" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
            <TextBox x:Name="UrlBox" Style="{StaticResource SWFieldStyle}" Height="28" />

            <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,4" />
            <TextBox x:Name="UsernameBox" Style="{StaticResource SWFieldStyle}" Height="28" />

            <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,4" />
            <PasswordBox x:Name="PasswordBox" Height="28"
                         Padding="6,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="{StaticResource BrushBorder}"
                         BorderThickness="1"
                         Background="White" />

            <!-- Advanced: raw API key for manual override or diagnostics -->
            <Expander x:Name="AdvancedExpander"
                      Header="Advanced — paste API key directly"
                      Margin="0,12,0,0"
                      Foreground="{StaticResource BrushSubtle}"
                      FontSize="{StaticResource FontSizeBody}">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Text="API Key" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                    <TextBox x:Name="ApiBox" Style="{StaticResource SWFieldStyle}" Height="28" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource BrushSubtle}"
                               TextWrapping="Wrap"
                               Text="Leave username and password blank to use this key directly." />
                </StackPanel>
            </Expander>

            <!-- Status message -->
            <TextBlock x:Name="StatusText"
                       Height="24"
                       Margin="0,10,0,0"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource BrushSubtle}"
                       FontSize="{StaticResource FontSizeBody}" />

            <!-- Buttons -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Test Connection"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="140" Margin="0"
                        Click="Test_Click" />

                <Button Grid.Column="2" Content="Save"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="70" Margin="0"
                        IsDefault="True"
                        Click="Save_Click" />

                <Button Grid.Column="4" Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="70" Margin="0"
                        IsCancel="True"
                        Click="Cancel_Click" />
            </Grid>

        </StackPanel>
    </StackPanel>
</Window>
