<Window
    x:Class="SwInventreeAddin.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:SwInventreeAddin.UI"
    Title="{Binding Version, StringFormat='InvenTree Link Settings - v{0}'}"
    Width="480"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="Manual"
    ShowInTaskbar="False"
    FontFamily="{DynamicResource FontBody}"
    FontSize="{DynamicResource FontSizeBody}">

    <!-- DynamicResource on the font attributes: Window.Resources is parsed
         after the root element's attributes, so a StaticResource lookup here
         cannot see DesignTokens. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel>

        <!-- Blue accent stripe -->
        <Border Height="4" Background="{StaticResource BrushAccentBlue}" />

        <StackPanel Margin="16,14,16,16">

            <!-- ── Server Connection section ──────────────────────────────── -->
            <!-- Banded section header — the Task Pane chrome (3px accent
                 stripe on the left rail + grey band), inset within the body
                 padding. The band is the separator; all section content
                 spans the band's full body width. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="{StaticResource BrushAccentBlue}" />
                <Border Grid.Column="1"
                        Background="{StaticResource BrushSectionHeader}"
                        Padding="6,4">
                    <TextBlock Text="InvenTree Server Connection"
                               Style="{StaticResource SectionTitleStyle}"
                               FontSize="{StaticResource FontSizeHeading}" />
                </Border>
            </Grid>

            <TextBlock Text="InvenTree server address and credentials."
                       Style="{StaticResource SectionIntroStyle}"
                       Margin="{StaticResource RowSpacing}" />

            <!-- Status card: fixed three-line layout once anything is saved.
                 Only the dot, title, and line values change between states —
                 never the structure. The API key is never shown here (ADR-0022). -->
            <Border x:Name="ConnectionCard"
                    Margin="{StaticResource SectionSpacing}"
                    Padding="10,8"
                    Background="{StaticResource BrushCardSummary}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnectionStatusDot"
                                 Width="10" Height="10"
                                 StrokeThickness="1.5"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="ConnectionCardTitle"
                                   Margin="8,0,0,0"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushForeground}" />
                    </StackPanel>

                    <Grid Margin="{StaticResource SectionSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Server"
                                   Foreground="{StaticResource BrushSubtle}" />
                        <TextBlock x:Name="ConnectionCardServer"
                                   Grid.Row="0" Grid.Column="1"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource BrushForeground}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Credential"
                                   Foreground="{StaticResource BrushSubtle}" />
                        <TextBlock x:Name="ConnectionCardCredential"
                                   Grid.Row="1" Grid.Column="1"
                                   Foreground="{StaticResource BrushForeground}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Connection"
                                   Foreground="{StaticResource BrushSubtle}" />
                        <TextBlock x:Name="ConnectionCardConnection"
                                   Grid.Row="2" Grid.Column="1"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource BrushForeground}" />
                    </Grid>

                    <!-- Toolbar exists only while the card summarizes a complete
                         config — in the auth state the form below is already open.
                         A divider separates it from the status lines; the change
                         actions sit left-of-center in standard chrome and the
                         destructive action anchors the right edge. -->
                    <Grid x:Name="ConnectionCardToolbar"
                          Margin="0,10,0,0"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Separator x:Name="ConnectionCardToolbarDivider"
                                   Grid.Row="0"
                                   Background="{StaticResource BrushBorder}" />

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ChangeServerButton"
                                    Grid.Column="0"
                                    Style="{StaticResource CardToolbarButtonStyle}"
                                    Click="ChangeServer_Click">
                                <TextBlock Text="Change server" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="ChangeCredentialButton"
                                    Grid.Column="2"
                                    Style="{StaticResource CardToolbarButtonStyle}"
                                    Click="ChangeCredential_Click">
                                <TextBlock Text="Change credential" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="RemoveApiKeyButton"
                                    Grid.Column="4"
                                    Style="{StaticResource CardToolbarDangerButtonStyle}"
                                    Click="RemoveApiKey_Click">
                                <TextBlock Text="Remove API key" VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- One plain form: Server URL, then username+password OR the key.
                 No mode switcher, no Show/Hide — the key field is always masked.
                 The MaxHeight keeps the expanded dialog inside a small monitor. -->
            <ScrollViewer x:Name="CredentialFormScroll"
                          Visibility="Collapsed"
                          MaxHeight="340"
                          Margin="{StaticResource SectionSpacing}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">

                    <StackPanel x:Name="UrlFieldPanel">
                        <TextBlock Text="Server URL" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="UrlBox" Style="{StaticResource SWFieldStyle}" Height="28" />
                    </StackPanel>

                    <StackPanel x:Name="CredentialFieldsPanel">
                        <!-- The credential choice sits in its own box so the
                             "or" divider reads as username+password OR API
                             key — the Server URL is never part of the choice.
                             The "Credential" label leads the box from outside,
                             in the same muted field-label treatment as
                             "Server URL". Canvas white, not the card grey:
                             grey marks the summary card above; this box is
                             the edit surface. -->
                        <TextBlock x:Name="CredentialGroupLabel"
                                   Text="Credential"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <Border x:Name="CredentialGroup"
                                Margin="{StaticResource SectionSpacing}"
                                Padding="10,8"
                                Background="White"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="UsernameBox" Style="{StaticResource SWFieldStyle}" Height="28" />

                                <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}" />
                                <PasswordBox x:Name="PasswordBox" Height="28"
                                             Style="{StaticResource SWPasswordBoxStyle}" />
                                <TextBlock Margin="{StaticResource RowSpacing}"
                                           Style="{StaticResource SectionIntroStyle}"
                                           Text="Used once to request an API token &#x2014; the password itself is not saved." />

                                <!-- "or" divider -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Separator Grid.Column="0" VerticalAlignment="Center"
                                               Background="{StaticResource BrushBorder}" />
                                    <TextBlock x:Name="CredentialOrDivider"
                                               Grid.Column="1" Text="or"
                                               Margin="8,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushSubtle}" />
                                    <Separator Grid.Column="2" VerticalAlignment="Center"
                                               Background="{StaticResource BrushBorder}" />
                                </Grid>

                                <TextBlock Text="API Key" Style="{StaticResource FieldLabelStyle}" />
                                <Grid>
                                    <PasswordBox x:Name="ApiKeyBox" Height="28"
                                                 Style="{StaticResource SWPasswordBoxStyle}" />
                                    <!-- Placeholder overlays: dots stand in for a saved
                                         key (never the key itself); a paste prompt shows
                                         when no key is saved. Both ignore hit-testing so
                                         the PasswordBox stays editable underneath. -->
                                    <TextBlock x:Name="ApiKeyDotsPlaceholder"
                                               Text="&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;"
                                               FontSize="{StaticResource FontSizeHeading}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushSubtle}"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed" />
                                    <TextBlock x:Name="ApiKeyPromptPlaceholder"
                                               Text="Paste key"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushSubtle}"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed" />
                                </Grid>
                                <TextBlock Margin="{StaticResource RowSpacing}"
                                           Style="{StaticResource SectionIntroStyle}"
                                           Text="If both are filled, the API key is used." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Section action row: the connection status bar reports what the
                 last connection-scoped action did (Test connection, Remove API
                 key); Apply/Save outcomes report on the footer action bar, and
                 the card above holds the persistent state. Test connection is
                 connection-scoped — it never saves. -->
            <Grid x:Name="ConnectionActionRow" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:StatusBarControl x:Name="ConnectionStatusBar"
                                     Grid.Column="0"
                                     VerticalAlignment="Center" />

                <Button x:Name="TestConnectionButton"
                        Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="120" Margin="0"
                        VerticalAlignment="Center"
                        Click="Test_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Test connection" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE703;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ── Property Mappings section ──────────────────────────────── -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="{StaticResource BrushAccentBlue}" />
                <Border Grid.Column="1"
                        Background="{StaticResource BrushSectionHeader}"
                        Padding="6,4">
                    <TextBlock Text="Property &amp; Table Mappings"
                               Style="{StaticResource SectionTitleStyle}"
                               FontSize="{StaticResource FontSizeHeading}" />
                </Border>
            </Grid>

            <TextBlock Text="Map InvenTree Part fields to SolidWorks custom property names and InvenTree line-item fields with assembly BOM table headers. A shared team file can be used to keep everyone in sync."
                       Style="{StaticResource SectionIntroStyle}"
                       Margin="{StaticResource RowSpacing}" />

            <!-- The mapping file source is a boxed edit region, like the
                 credential group — radios, path fields, and Browse fence
                 inside; Edit Mappings and the health bar stay outside. Path
                 fields indent under their radio's label. -->
            <Border x:Name="MappingEditGroup"
                    Margin="{StaticResource SectionSpacing}"
                    Padding="10,8"
                    Background="White"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1">
                <StackPanel>
                    <!-- Labels sit in each radio's Content so clicking the text
                         toggles the radio; both wear the same foreground. -->
                    <RadioButton x:Name="LocalRadio"
                                 GroupName="MappingSource"
                                 IsChecked="True"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,4"
                                 Checked="LocalRadio_Checked">
                        <TextBlock Text="Local mapping file"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushForeground}" />
                    </RadioButton>

                    <!-- Local file path (read-only) -->
                    <Grid Margin="20,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Focusable: the style parks non-focusable for display-only
                             fields; this path is copied by hand into Explorer. -->
                        <TextBox x:Name="LocalPathBox"
                                 Grid.Column="0"
                                 Style="{StaticResource ValueFieldStyle}"
                                 Focusable="True"
                                 Height="28" />
                    </Grid>

                    <RadioButton x:Name="SharedRadio"
                                 GroupName="MappingSource"
                                 VerticalAlignment="Center"
                                 Margin="0,12,0,4"
                                 Checked="SharedRadio_Checked">
                        <TextBlock Text="Shared mapping file (optional)"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushForeground}" />
                    </RadioButton>

                    <!-- Shared file path + Browse button -->
                    <Grid Margin="20,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SharedPathBox"
                                 Grid.Column="0"
                                 Style="{StaticResource SWFieldStyle}"
                                 Height="28" />
                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="28" MinWidth="120"
                                Width="{Binding ElementName=EditMappingsButton, Path=ActualWidth, FallbackValue=150}"
                                Margin="0"
                                Click="Browse_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Browse&#x2026;" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Edit Mappings + mapping status bar -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:StatusBarControl x:Name="MappingStatusBar"
                                     Grid.Column="0" />

                <Button x:Name="EditMappingsButton"
                        Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="28" MinWidth="120"
                        VerticalAlignment="Center"
                        Click="EditMappings_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="EditMappingsButtonText" Text="Edit Mappings" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ── BOM keyword section ────────────────────────────────────── -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="{StaticResource BrushAccentBlue}" />
                <Border Grid.Column="1"
                        Background="{StaticResource BrushSectionHeader}"
                        Padding="6,4">
                    <TextBlock Text="Keyword in the SOLIDWORKS BOM Table Name"
                               Style="{StaticResource SectionTitleStyle}"
                               FontSize="{StaticResource FontSizeHeading}" />
                </Border>
            </Grid>

            <TextBlock Text="Name fragment the add-in BOM Compare function uses to find the SolidWorks BOM table for InvenTree sync."
                       Style="{StaticResource SectionIntroStyle}"
                       Margin="{StaticResource RowSpacing}" />

            <!-- Bare label + field — the one edit region that stays unboxed
                 (decided in #252 triage); it spans the band's full body width. -->
            <TextBlock Text="Keyword" Style="{StaticResource FieldLabelStyle}"
                       Margin="0,6,0,2" />
            <TextBox x:Name="BomKeywordBox" Style="{StaticResource SWFieldStyle}" Height="28" />

            <!-- Footer: dialog-level action status bar + Apply / Save / Cancel.
                 The action bar reports what Apply/Save did; connection-scoped
                 outcomes (Test connection, Remove API key) live up in the Server
                 Connection section's own status bar. -->
            <Grid x:Name="DialogActionRow" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:StatusBarControl x:Name="ActionStatusBar"
                                     Grid.Column="0"
                                     VerticalAlignment="Center" />

                <Button x:Name="ApplyButton"
                        Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="80" Margin="0"
                        VerticalAlignment="Center"
                        Click="Apply_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Apply" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton"
                        Grid.Column="4"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="80" Margin="0"
                        VerticalAlignment="Center"
                        IsDefault="True"
                        Click="Save_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Save" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelButton"
                        Grid.Column="6"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="80" Margin="0"
                        VerticalAlignment="Center"
                        IsCancel="True"
                        Click="Cancel_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="CancelButtonText" Text="Cancel" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

        </StackPanel>
    </StackPanel>
</Window>
