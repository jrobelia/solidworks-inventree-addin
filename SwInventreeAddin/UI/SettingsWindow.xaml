<Window
    x:Class="SwInventreeAddin.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:SwInventreeAddin.UI"
    Title="{Binding Version, StringFormat='InvenTree Settings - v{0}'}"
    Width="480"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="Manual"
    ShowInTaskbar="False"
    FontFamily="Segoe UI"
    FontSize="12">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel>

        <!-- Blue accent stripe -->
        <Border Height="4" Background="{StaticResource BrushAccentBlue}" />

        <StackPanel Margin="16,14,16,16">

            <!-- ── Server Connection section ──────────────────────────────── -->

            <TextBlock Text="Inventree Server Connection"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource BrushForeground}" />

            <!-- Status card: fixed three-line layout once anything is saved.
                 Only the dot, title, and line values change between states —
                 never the structure. The API key is never shown here (ADR-0022). -->
            <Border x:Name="ConnectionCard"
                    Margin="0,8,0,0"
                    Padding="10,8"
                    Background="{StaticResource BrushSectionHeader}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnectionStatusDot"
                                 Width="10" Height="10"
                                 StrokeThickness="1.5"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="ConnectionCardTitle"
                                   Margin="8,0,0,0"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushForeground}" />
                    </StackPanel>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Server"
                                   Foreground="{StaticResource BrushSubtle}" />
                        <TextBlock x:Name="ConnectionCardServer"
                                   Grid.Row="0" Grid.Column="1"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource BrushForeground}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Credential"
                                   Foreground="{StaticResource BrushSubtle}" />
                        <TextBlock x:Name="ConnectionCardCredential"
                                   Grid.Row="1" Grid.Column="1"
                                   Foreground="{StaticResource BrushForeground}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Connection"
                                   Foreground="{StaticResource BrushSubtle}" />
                        <TextBlock x:Name="ConnectionCardConnection"
                                   Grid.Row="2" Grid.Column="1"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource BrushForeground}" />
                    </Grid>

                    <!-- Toolbar exists only while the card summarizes a complete
                         config — in the auth state the form below is already open. -->
                    <StackPanel x:Name="ConnectionCardToolbar"
                                Orientation="Horizontal"
                                Margin="0,8,0,0"
                                Visibility="Collapsed">
                        <Button x:Name="ChangeServerButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="24" Margin="0,0,6,0"
                                Click="ChangeServer_Click">
                            <TextBlock Text="Change server" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="ChangeCredentialButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="24" Margin="0,0,6,0"
                                Click="ChangeCredential_Click">
                            <TextBlock Text="Change credential" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="RemoveApiKeyButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="24" Margin="0"
                                Click="RemoveApiKey_Click">
                            <TextBlock Text="Remove API key" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- One plain form: Server URL, then username+password OR the key.
                 No mode switcher, no Show/Hide — the key field is always masked.
                 The MaxHeight keeps the expanded dialog inside a small monitor. -->
            <ScrollViewer x:Name="CredentialFormScroll"
                          Visibility="Collapsed"
                          MaxHeight="340"
                          Margin="0,10,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">

                    <StackPanel x:Name="UrlFieldPanel">
                        <TextBlock Text="Server URL" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                        <TextBox x:Name="UrlBox" Style="{StaticResource SWFieldStyle}" Height="28" />
                    </StackPanel>

                    <StackPanel x:Name="CredentialFieldsPanel">
                        <!-- The credential choice sits in its own labelled box so
                             the "or" divider reads as username+password OR API
                             key — the Server URL is never part of the choice.
                             Canvas white, not the card grey: grey marks the
                             summary card above; this box is the edit surface. -->
                        <Border x:Name="CredentialGroup"
                                Margin="0,8,0,0"
                                Padding="10,8"
                                Background="White"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="CredentialGroupLabel"
                                           Text="Credential"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushForeground}" />

                                <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,4" />
                                <TextBox x:Name="UsernameBox" Style="{StaticResource SWFieldStyle}" Height="28" />

                                <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,4" />
                                <PasswordBox x:Name="PasswordBox" Height="28"
                                             Style="{StaticResource SWPasswordBoxStyle}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{StaticResource BrushSubtle}"
                                           TextWrapping="Wrap"
                                           Text="Used once to request an API token &#x2014; the password itself is not saved." />

                                <!-- "or" divider -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Separator Grid.Column="0" VerticalAlignment="Center"
                                               Background="{StaticResource BrushBorder}" />
                                    <TextBlock x:Name="CredentialOrDivider"
                                               Grid.Column="1" Text="or"
                                               Margin="8,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushSubtle}" />
                                    <Separator Grid.Column="2" VerticalAlignment="Center"
                                               Background="{StaticResource BrushBorder}" />
                                </Grid>

                                <TextBlock Text="API Key" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,4" />
                                <Grid>
                                    <PasswordBox x:Name="ApiKeyBox" Height="28"
                                                 Style="{StaticResource SWPasswordBoxStyle}" />
                                    <!-- Placeholder overlays: dots stand in for a saved
                                         key (never the key itself); a paste prompt shows
                                         when no key is saved. Both ignore hit-testing so
                                         the PasswordBox stays editable underneath. -->
                                    <TextBlock x:Name="ApiKeyDotsPlaceholder"
                                               Text="&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushSubtle}"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed" />
                                    <TextBlock x:Name="ApiKeyPromptPlaceholder"
                                               Text="Paste key"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushSubtle}"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed" />
                                </Grid>
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{StaticResource BrushSubtle}"
                                           TextWrapping="Wrap"
                                           Text="If both are filled, the API key is used." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Section action row: the connection status bar reports what the
                 last connection-scoped action did (Test connection, Remove API
                 key); Apply/Save outcomes report on the footer action bar, and
                 the card above holds the persistent state. Test connection is
                 connection-scoped — it never saves. -->
            <Grid x:Name="ConnectionActionRow" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:StatusBarControl x:Name="ConnectionStatusBar"
                                     Grid.Column="0"
                                     VerticalAlignment="Center" />

                <Button x:Name="TestConnectionButton"
                        Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="120" Margin="0"
                        VerticalAlignment="Center"
                        Click="Test_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Test connection" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE703;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ── Separator ────────────────────────────────────────────────── -->
            <Separator Background="{StaticResource BrushBorder}" Margin="0,14,0,0" />

            <!-- ── Property Mappings section ──────────────────────────────── -->

            <TextBlock Text="Inventree to Solidworks Mappings"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource BrushForeground}"
                       Margin="0,12,0,0" />

            <TextBlock Text="Map InvenTree Part fields to SolidWorks custom property names and InvenTree line-item fields with assembly BOM table headers. A shared team file can be used to keep everyone in sync."
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,8,0,4"
                       TextWrapping="Wrap" />

            <!-- Local radio + label -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,4" VerticalAlignment="Center">
                <RadioButton x:Name="LocalRadio"
                             GroupName="MappingSource"
                             IsChecked="True"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0"
                             Checked="LocalRadio_Checked" />
                <TextBlock x:Name="LocalRadioLabel"
                           Text="Local mapping file"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushForeground}" />
            </StackPanel>

            <!-- Local file path (read-only) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="LocalPathBox"
                         Grid.Column="0"
                         Style="{StaticResource SWFieldStyle}"
                         Background="{StaticResource BrushSectionHeader}"
                         IsReadOnly="True"
                         Height="28" />
            </Grid>

            <!-- Shared radio + label -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,4" VerticalAlignment="Center">
                <RadioButton x:Name="SharedRadio"
                             GroupName="MappingSource"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0"
                             Checked="SharedRadio_Checked" />
                <TextBlock Text="Shared mapping file (optional)"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushSubtle}" />
            </StackPanel>

            <!-- Shared file path + Browse button -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SharedPathBox"
                         Grid.Column="0"
                         Style="{StaticResource SWFieldStyle}"
                         Height="28" />
                <Button Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="28" MinWidth="120"
                        Width="{Binding ElementName=EditMappingsButton, Path=ActualWidth, FallbackValue=150}"
                        Margin="0"
                        Click="Browse_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Browse&#x2026;" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Edit Mappings + mapping status bar -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:StatusBarControl x:Name="MappingStatusBar"
                                     Grid.Column="0" />

                <Button x:Name="EditMappingsButton"
                        Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="28" MinWidth="120"
                        VerticalAlignment="Center"
                        Click="EditMappings_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="EditMappingsButtonText" Text="Edit Mappings" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ── Separator ────────────────────────────────────────────────── -->
            <Separator Background="{StaticResource BrushBorder}" Margin="0,14,0,0" />

            <!-- ── BOM sync section ─────────────────────────────────────────- -->

            <TextBlock Text="SolidWorks BOM Table Name Keyword"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource BrushForeground}"
                       Margin="0,12,0,0" />

            <TextBlock Text="Name fragment the add-in BOM Compare function uses to find the SolidWorks BOM table for InvenTree sync."
                       Style="{StaticResource FieldLabelStyle}"
                       FontSize="11" Opacity="0.6" Margin="0,0,0,6"
                       TextWrapping="Wrap" />
            <TextBox x:Name="BomKeywordBox" Style="{StaticResource SWFieldStyle}" />

            <!-- Footer: dialog-level action status bar + Apply / Save / Cancel.
                 The action bar reports what Apply/Save did; connection-scoped
                 outcomes (Test connection, Remove API key) live up in the Server
                 Connection section's own status bar. -->
            <Grid x:Name="DialogActionRow" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:StatusBarControl x:Name="ActionStatusBar"
                                     Grid.Column="0"
                                     VerticalAlignment="Center" />

                <Button x:Name="ApplyButton"
                        Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="80" Margin="0"
                        VerticalAlignment="Center"
                        Click="Apply_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Apply" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton"
                        Grid.Column="4"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="80" Margin="0"
                        VerticalAlignment="Center"
                        IsDefault="True"
                        Click="Save_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Save" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelButton"
                        Grid.Column="6"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="80" Margin="0"
                        VerticalAlignment="Center"
                        IsCancel="True"
                        Click="Cancel_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="CancelButtonText" Text="Cancel" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

        </StackPanel>
    </StackPanel>
</Window>
