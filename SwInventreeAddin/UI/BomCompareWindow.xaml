<Window
    x:Class="SwInventreeAddin.UI.BomCompareWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BOM Comparison"
    Width="960" Height="620"
    WindowStartupLocation="CenterOwner"
    FontFamily="Segoe UI"
    FontSize="12"
    Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DesignTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>

        <!-- Blue header stripe -->
        <Border DockPanel.Dock="Top" Height="4"
                Background="{StaticResource BrushAccentBlue}"/>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Assembly label -->
            <TextBlock Grid.Row="0" x:Name="AssemblyLabel"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource BrushForeground}"
                       Margin="0,0,0,8"/>

            <!-- Bulk-select toolbar -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Select All"
                        Click="SelectAll_Click"
                        Width="90" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"/>
                <Button Content="Select None"
                        Click="SelectNone_Click"
                        Width="90" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"/>
                <Button Content="Select New"
                        Click="SelectNew_Click"
                        Width="90" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"/>
                <Button Content="Select Conflicts"
                        Click="SelectConflicts_Click"
                        Width="110" Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>

            <!-- DataGrid -->
            <DataGrid Grid.Row="2"
                      x:Name="BomGrid"
                      ItemsSource="{Binding Lines}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="False" SelectionMode="Single"
                      Margin="0,0,0,8">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                            Header="" Width="28"/>
                    <DataGridTextColumn Header="State"     Binding="{Binding StateLabel}"   Width="80"  IsReadOnly="True"/>
                    <DataGridTextColumn Header="IPN"       Binding="{Binding DisplayIpn}"   Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="SW Qty"    Binding="{Binding SwQty}"        Width="55"  IsReadOnly="True"/>
                    <DataGridTextColumn Header="SW Ref."   Binding="{Binding SwReference}"  Width="*"   IsReadOnly="True"/>
                    <DataGridTextColumn Header="SW Note"   Binding="{Binding SwNote}"       Width="*"   IsReadOnly="True"/>
                    <DataGridTextColumn Header="IT Qty"    Binding="{Binding ItQty}"        Width="55"  IsReadOnly="True"/>
                    <DataGridTextColumn Header="IT Ref."   Binding="{Binding ItReference}"  Width="*"   IsReadOnly="True"/>
                    <DataGridTextColumn Header="IT Note"   Binding="{Binding ItNote}"       Width="*"   IsReadOnly="True"/>
                    <DataGridTextColumn Header="Subs."     Binding="{Binding HasSubstitutes}" Width="44" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Footer -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Style="{StaticResource FieldLabelStyle}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Push Selected to InvenTree"
                        IsEnabled="{Binding ApplyEnabled}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Apply_Click"
                        Width="195" Margin="0,0,4,0"/>
                <Button Grid.Column="2"
                        Content="Close"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Close_Click"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
