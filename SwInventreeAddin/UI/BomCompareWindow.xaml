<Window
    x:Class="SwInventreeAddin.UI.BomCompareWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BOM Comparison"
    Width="960" Height="620"
    WindowStartupLocation="Manual"
    ShowInTaskbar="False"
    FontFamily="Segoe UI"
    FontSize="12"
    Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DesignTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Shared text-cell margin so values don't sit flush with the grid lines.
                 A custom ElementStyle replaces the column's default style, which is what
                 normally supplies this margin — every text column opts in explicitly. -->
            <Style x:Key="BomCellTextStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="6,0"/>
            </Style>
            <!-- Shared column-header chrome: left gutter matching the cells and a
                 separator so the vertical grid lines continue through the header row. -->
            <Style x:Key="BomHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Padding" Value="6,4,4,4"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            </Style>

            <!-- Shared cell chrome — selection highlight suppressed; the row
                 colour does the work and the checkbox shows selection. Named so
                 per-column CellStyle blocks can build on it for the differing-
                 cell tint. -->
            <Style x:Key="BomCellStyle" TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush"  Value="Transparent"/>
                        <Setter Property="Foreground"   Value="{StaticResource BrushForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- State column: the mock's colored Semibold 11px label per
                 BOM Diff State. -->
            <Style x:Key="BomStateLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BomCellTextStyle}">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Match">
                        <Setter Property="Foreground" Value="{StaticResource BrushMatch}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Conflict">
                        <Setter Property="Foreground" Value="{StaticResource BrushBomStateConflict}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="New">
                        <Setter Property="Foreground" Value="{StaticResource BrushAccentBlue}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="InvenTreeOnly">
                        <Setter Property="Foreground" Value="{StaticResource BrushSubtle}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="NoIpn">
                        <Setter Property="Foreground" Value="{StaticResource BrushSubtle}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="IpnNotFound">
                        <Setter Property="Foreground" Value="{StaticResource BrushBomStateNotFound}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Ambiguous">
                        <Setter Property="Foreground" Value="{StaticResource BrushBomStateConflict}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- The surviving IPN on a problem row keeps the state colour. -->
            <Style x:Key="BomProblemIpnStyle" TargetType="TextBlock" BasedOn="{StaticResource BomCellTextStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="IpnNotFound">
                        <Setter Property="Foreground" Value="{StaticResource BrushBomStateNotFound}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Ambiguous">
                        <Setter Property="Foreground" Value="{StaticResource BrushBomStateConflict}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Problem-row guidance: the mock's 11px subtle line that spans
                 the data cells. Sits in a Canvas so it can overflow the cell
                 it starts in. -->
            <Style x:Key="BomGuidanceStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource BrushSubtle}"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
            </Style>

            <!-- Problem rows show only their state label, IPN and guidance —
                 the guidance line carries the "what to do", so the data cells
                 stay empty like the mock's spanning message. -->
            <Style x:Key="BomHiddenOnProblemStyle" TargetType="TextBlock" BasedOn="{StaticResource BomCellTextStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsProblemState}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Data cells: hidden on problem rows; a differing value on a
                 Conflict row takes the mock's emphasis — Semibold state orange. -->
            <Style x:Key="BomQtyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BomHiddenOnProblemStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding QtyConflict}" Value="True">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushBomStateConflict}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="BomRefTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BomHiddenOnProblemStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ReferenceConflict}" Value="True">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushBomStateConflict}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="BomNoteTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BomHiddenOnProblemStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding NoteConflict}" Value="True">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushBomStateConflict}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>

        <!-- Blue header stripe -->
        <Border DockPanel.Dock="Top" Height="4"
                Background="{StaticResource BrushAccentBlue}"/>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Banded section header — the .pen dialogTitleBar treatment
                 (3px accent stripe + grey band), same chrome the Task Pane
                 and Settings section headers use. -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="{StaticResource BrushAccentBlue}"/>
                <Border Grid.Column="1"
                        Background="{StaticResource BrushSectionHeader}"
                        Padding="6,4">
                    <TextBlock Text="BOM Comparison"
                               Style="{StaticResource SectionTitleStyle}"
                               FontSize="{StaticResource FontSizeHeading}"/>
                </Border>
            </Grid>

            <!-- Assembly label -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock x:Name="AssemblyIpn"
                           Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock x:Name="AssemblyName"
                           Style="{StaticResource SectionIntroStyle}"
                           VerticalAlignment="Bottom"
                           Margin="8,0,0,1"/>
            </StackPanel>

            <!-- BOM table info row -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock x:Name="BomTableName"
                           Style="{StaticResource SectionIntroStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Bulk-select toolbar -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Select All"
                        Click="SelectAll_Click"
                        Width="90" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"/>
                <Button Content="Select None"
                        Click="SelectNone_Click"
                        Width="90" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"/>
                <Button Content="Select New"
                        Click="SelectNew_Click"
                        Width="90" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"/>
                <Button Content="Select Conflicts"
                        Click="SelectConflicts_Click"
                        Width="110" Style="{StaticResource SecondaryButtonStyle}" Margin="0"/>
            </StackPanel>

            <!-- Whole-table frame — one border encloses the group header band and the DataGrid -->
            <Border Grid.Row="4"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                    Margin="0,0,0,8"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Column group header — widths set in code-behind via BomGrid_LayoutUpdated -->
                    <Grid x:Name="GroupHeaderGrid" Grid.Row="0" Height="22" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="GhColLeft" Width="208"/>
                            <ColumnDefinition x:Name="GhColSw"   Width="165"/>
                            <ColumnDefinition x:Name="GhColIt"   Width="1"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource BrushBomHeader}"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0"/>
                        <Border Grid.Column="1" Background="{StaticResource BrushBomGroupSw}">
                            <TextBlock Text="SolidWorks" FontWeight="SemiBold" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource BrushBomGroupIt}"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1,0,0,0">
                            <TextBlock Text="InvenTree" FontWeight="SemiBold" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Separator between the group header band and the column headers -->
                    <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1"
                            Background="{StaticResource BrushGridLine}" SnapsToDevicePixels="True"/>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                              x:Name="BomGrid"
                              ItemsSource="{Binding Lines}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="False" SelectionMode="Single"
                              RowHeaderWidth="0"
                              LayoutUpdated="BomGrid_LayoutUpdated"
                              ColumnHeaderHeight="26"
                              BorderThickness="0"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="{StaticResource BrushGridLine}"
                              VerticalGridLinesBrush="{StaticResource BrushGridLine}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="New">
                                        <Setter Property="Background" Value="{StaticResource BrushBomRowNew}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Conflict">
                                        <Setter Property="Background" Value="{StaticResource BrushBomRowConflict}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="InvenTreeOnly">
                                        <Setter Property="Background" Value="{StaticResource BrushInventreeField}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="NoIpn">
                                        <Setter Property="Background" Value="{StaticResource BrushBomRowNoIpn}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="IpnNotFound">
                                        <Setter Property="Background" Value="{StaticResource BrushBomRowNotFound}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Ambiguous">
                                        <Setter Property="Background" Value="{StaticResource BrushBomRowAmbiguous}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <!-- Suppress the default blue/grey cell selection highlight.
                             Row colour comes from RowStyle above; checkbox shows selection. -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource BomCellStyle}"/>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="28" CanUserSort="False">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BomHeaderStyle}">
                                        <Setter Property="Background" Value="{StaticResource BrushBomHeader}"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- A template CheckBox toggles on first click; an editing
                                             column (DataGridCheckBoxColumn) spends the first click
                                             entering edit mode. IsChecked's setter still refuses
                                             rows that cannot be pushed. -->
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsEnabled="{Binding CanCheck}"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="State"   Binding="{Binding StateLabel}"  Width="80"  IsReadOnly="True"
                                                ElementStyle="{StaticResource BomStateLabelStyle}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BomHeaderStyle}">
                                        <Setter Property="Background" Value="{StaticResource BrushBomHeader}"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="IPN" Width="100" CanUserSort="False" IsReadOnly="True">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BomHeaderStyle}">
                                        <Setter Property="Background" Value="{StaticResource BrushBomHeader}"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock x:Name="IpnText"
                                                       Text="{Binding DisplayIpn}"
                                                       Style="{StaticResource BomProblemIpnStyle}"/>
                                            <!-- No-IPN rows have no IPN to print, so the guidance
                                                 line starts in this cell — the Canvas does not
                                                 constrain it, and it paints across the empty
                                                 data cells like the mock's spanning message. -->
                                            <Canvas x:Name="Guidance" IsHitTestVisible="False"
                                                    Visibility="Collapsed">
                                                <TextBlock Text="{Binding GuidanceText}"
                                                           Style="{StaticResource BomGuidanceStyle}"/>
                                            </Canvas>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsProblemState}" Value="True"/>
                                                    <Condition Binding="{Binding HasDisplayIpn}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="IpnText" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Guidance" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="SW Qty" Width="55" CanUserSort="False" IsReadOnly="True">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BomHeaderStyle}">
                                        <Setter Property="Background" Value="{StaticResource BrushBomColSw}"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource BomCellStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QtyConflict}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushBomConflictCell}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock x:Name="QtyText"
                                                       Text="{Binding SwQty}"
                                                       Style="{StaticResource BomQtyTextStyle}"/>
                                            <!-- Problem rows that still show an IPN carry the
                                                 guidance line from here to the row's end. -->
                                            <Canvas x:Name="Guidance" IsHitTestVisible="False"
                                                    Visibility="Collapsed">
                                                <TextBlock Text="{Binding GuidanceText}"
                                                           Style="{StaticResource BomGuidanceStyle}"/>
                                            </Canvas>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsProblemState}" Value="True"/>
                                                    <Condition Binding="{Binding HasDisplayIpn}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Guidance" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="SW Ref." Binding="{Binding SwReference}" Width="*"   IsReadOnly="True"
                                                ElementStyle="{StaticResource BomRefTextStyle}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BomHeaderStyle}">
                                        <Setter Property="Background" Value="{StaticResource BrushBomColSw}"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource BomCellStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReferenceConflict}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushBomConflictCell}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="SW Note" Binding="{Binding SwNote}"      Width="*"   IsReadOnly="True"
                                                ElementStyle="{StaticResource BomNoteTextStyle}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BomHeaderStyle}">
                                        <Setter Property="Background" Value="{StaticResource BrushBomColSw}"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource BomCellStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NoteConflict}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushBomConflictCell}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Inv Qty"  Binding="{Binding ItQty}"       Width="55"  IsReadOnly="True"
                                                ElementStyle="{StaticResource BomQtyTextStyle}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BomHeaderStyle}">
                                        <Setter Property="Background" Value="{StaticResource BrushBomColIt}"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource BomCellStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QtyConflict}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushBomConflictCell}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Inv Ref." Binding="{Binding ItReference}" Width="*"   IsReadOnly="True"
                                                ElementStyle="{StaticResource BomRefTextStyle}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BomHeaderStyle}">
                                        <Setter Property="Background" Value="{StaticResource BrushBomColIt}"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource BomCellStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReferenceConflict}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushBomConflictCell}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Inv Note" Binding="{Binding ItNote}"      Width="*"   IsReadOnly="True"
                                                ElementStyle="{StaticResource BomNoteTextStyle}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BomHeaderStyle}">
                                        <Setter Property="Background" Value="{StaticResource BrushBomColIt}"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource BomCellStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NoteConflict}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushBomConflictCell}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Substitute Parts" Binding="{Binding HasSubstitutesLabel}" Width="96" IsReadOnly="True"
                                                ElementStyle="{StaticResource BomHiddenOnProblemStyle}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BomHeaderStyle}">
                                        <Setter Property="Background" Value="{StaticResource BrushBomColIt}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- SolidWorks/InvenTree group divider — positioned in code-behind via
                         BomGrid_LayoutUpdated so it runs continuously from the group header
                         down through the data rows -->
                    <Border x:Name="SwInventreeDivider" Grid.RowSpan="2"
                            Width="3" HorizontalAlignment="Left"
                            Background="{StaticResource BrushBorder}"
                            IsHitTestVisible="False"
                            SnapsToDevicePixels="True"/>
                </Grid>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="5" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusText}"
                               FontSize="11"
                               Foreground="{StaticResource BrushForeground}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            IsEnabled="{Binding PushEnabled}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Push_Click"
                            Width="220" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Push Selected to InvenTree" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2"
                            Content="Close"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Close_Click"
                            Margin="0"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
