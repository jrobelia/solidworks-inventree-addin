<Window
    x:Class="SwInventreeAddin.UI.ImageCropWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Crop Image for InvenTree"
    Width="900" Height="700"
    MinWidth="600" MinHeight="400"
    WindowStartupLocation="CenterOwner"
    FontFamily="Segoe UI"
    FontSize="12">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Blue accent stripe -->
        <Border DockPanel.Dock="Top" Height="4"
                Background="{StaticResource BrushAccentBlue}" />

        <!-- Bottom button bar -->
        <Border DockPanel.Dock="Bottom" Height="46"
                Background="#FFF0F0F0"
                BorderBrush="#FFD0D0D0" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="SquareLockCheck"
                          Grid.Column="0"
                          Content="Square crop"
                          IsChecked="True"
                          VerticalAlignment="Center" />

                <Button Grid.Column="2"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="100" Margin="0"
                        Click="Confirm_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Confirm" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="4"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="100" Margin="0"
                        IsCancel="True"
                        Click="Cancel_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cancel" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main content: source image + preview -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Source image with crop overlay -->
            <Grid x:Name="ImageContainer" Grid.Column="0"
                  Background="#FF1A1A1A"
                  ClipToBounds="True">

                <Image x:Name="SourceImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Canvas overlays the image for crop drawing -->
                <Canvas x:Name="OverlayCanvas"
                        Background="Transparent"
                        Cursor="Cross"
                        MouseLeftButtonDown="Canvas_MouseDown"
                        MouseMove="Canvas_MouseMove"
                        MouseLeftButtonUp="Canvas_MouseUp">

                    <!-- Single dim overlay with a transparent hole where the crop rectangle is -->
                    <Path x:Name="DimOverlay" Fill="#64000000" Visibility="Collapsed" />

                    <!-- Crop border -->
                    <Rectangle x:Name="CropBorder"
                               Stroke="Red" StrokeThickness="2"
                               Visibility="Collapsed" />
                </Canvas>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#FFD0D0D0" />

            <!-- Preview panel -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top"
                           Text="Preview"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,4" />
                <Border BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        Background="#FFE8E8E8">
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            </DockPanel>
        </Grid>

    </DockPanel>
</Window>
