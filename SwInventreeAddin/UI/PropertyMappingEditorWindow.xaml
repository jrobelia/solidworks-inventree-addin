<Window
    x:Class="SwInventreeAddin.UI.PropertyMappingEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Property Field Mappings"
    Width="480"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="Manual"
    ShowInTaskbar="False"
    Opacity="0"
    FontFamily="Segoe UI"
    FontSize="12">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="MappingFieldStyle" TargetType="TextBox" BasedOn="{StaticResource SWFieldStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <TextBlock x:Name="Placeholder"
                                               Text="{TemplateBinding Tag}"
                                               Foreground="{StaticResource BrushSubtle}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed"
                                               Margin="2,0,0,0" />
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Text" Value="" />
                                        <Condition Property="IsKeyboardFocused" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel>

        <!-- Blue accent stripe -->
        <Border Height="4" Background="{StaticResource BrushAccentBlue}" />

        <StackPanel Margin="16,14,16,16">

            <!-- Subtitle -->
            <TextBlock Text="Map InvenTree part properties to your SolidWorks custom property names."
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap" />

            <!-- Shared read-only older mapping banner (Copy to local) -->
            <Border x:Name="CopyToLocalPanel"
                    Visibility="Collapsed"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource BrushStatusWarning}" />
                    <Border Grid.Column="1" Background="#FFF8E1">
                        <StackPanel Margin="8,6,8,6">
                            <TextBlock Text="This shared mapping is older than the current schema. Copy it to your local file to edit it."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource BrushForeground}" />
                            <Button x:Name="CopyToLocalButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="140"
                                    Margin="0,6,0,0"
                                    Click="CopyToLocal_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Copy to local" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="CopyToLocalInstructionText"
                                       Text="{Binding CopyToLocalInstruction}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource BrushForeground}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Read-only banner (shared, healthy or invalid mappings) -->
            <Border x:Name="ReadOnlyBanner"
                    Visibility="Collapsed"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource BrushStatusWarning}" />
                    <Border Grid.Column="1" Background="#FFF8E1">
                        <TextBlock
                            x:Name="ReadOnlyBannerText"
                            Text="Loaded from a shared file — switch to Local in Settings to edit mappings."
                            Margin="8,6,8,6"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource BrushForeground}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Column headers -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="InvenTree Part Property"
                           Style="{StaticResource ColumnHeaderStyle}"
                           HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="SolidWorks Document Property"
                           Style="{StaticResource ColumnHeaderStyle}"
                           HorizontalAlignment="Left" />
            </Grid>

            <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,4" />

            <!-- IPN row -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="IPN"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource MappingFieldStyle}"
                         Height="26"
                         Text="{Binding IpnProperty, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding IpnPlaceholder}"
                         IsReadOnly="{Binding IsReadOnly}" />
            </Grid>

            <!-- Name row -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Name"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource MappingFieldStyle}"
                         Height="26"
                         Text="{Binding NameProperty, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding NamePlaceholder}"
                         IsReadOnly="{Binding IsReadOnly}" />
            </Grid>

            <!-- Description row -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Description"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource MappingFieldStyle}"
                         Height="26"
                         Text="{Binding DescriptionProperty, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding DescriptionPlaceholder}"
                         IsReadOnly="{Binding IsReadOnly}" />
            </Grid>

            <!-- Revision row -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Revision"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource MappingFieldStyle}"
                         Height="26"
                         Text="{Binding RevisionProperty, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding RevisionPlaceholder}"
                         IsReadOnly="{Binding IsReadOnly}" />
            </Grid>

            <!-- Notes row -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Notes"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource MappingFieldStyle}"
                         Height="26"
                         Text="{Binding NotesProperty, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding NotesPlaceholder}"
                         IsReadOnly="{Binding IsReadOnly}" />
            </Grid>

            <!-- InvenTree PK row -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="InvenTree PK"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource MappingFieldStyle}"
                         Height="26"
                         Text="{Binding PkProperty, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding PkPlaceholder}"
                         IsReadOnly="{Binding IsReadOnly}" />
            </Grid>

            <!-- BOM Column Alias section -->
            <TextBlock Text="BOM Column Aliases"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource BrushForeground}"
                       Margin="0,14,0,4" />
            <TextBlock Text="Enter comma-separated SolidWorks BOM column headers for each InvenTree field."
                       Style="{StaticResource FieldLabelStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4" />

            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="IPN"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource MappingFieldStyle}"
                         Height="26"
                         Text="{Binding BomColumnIpn, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding BomColumnIpnPlaceholder}"
                         IsReadOnly="{Binding IsReadOnly}" />
            </Grid>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Qty"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource MappingFieldStyle}"
                         Height="26"
                         Text="{Binding BomColumnQty, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding BomColumnQtyPlaceholder}"
                         IsReadOnly="{Binding IsReadOnly}" />
            </Grid>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Reference"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource MappingFieldStyle}"
                         Height="26"
                         Text="{Binding BomColumnReference, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding BomColumnReferencePlaceholder}"
                         IsReadOnly="{Binding IsReadOnly}" />
            </Grid>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Note"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource MappingFieldStyle}"
                         Height="26"
                         Text="{Binding BomColumnNote, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding BomColumnNotePlaceholder}"
                         IsReadOnly="{Binding IsReadOnly}" />
            </Grid>

            <!-- Validation / status / copy instruction -->
            <TextBlock x:Name="ErrorText"
                       Visibility="Collapsed"
                       Foreground="{StaticResource BrushStatusError}"
                       FontSize="{StaticResource FontSizeBody}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />

            <!-- Buttons -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SaveButton"
                        Grid.Column="1"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="80" Margin="0"
                        IsDefault="True"
                        Click="Save_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Save" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="80" Margin="0"
                        IsCancel="True"
                        Click="Cancel_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cancel" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

        </StackPanel>
    </StackPanel>
</Window>
