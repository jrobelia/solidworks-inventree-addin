<Window
    x:Class="SwInventreeAddin.UI.PropertyMappingEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Property Field Mappings"
    Width="480"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="Manual"
    ShowInTaskbar="False"
    FontFamily="Segoe UI"
    FontSize="12">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="MappingFieldStyle" TargetType="TextBox" BasedOn="{StaticResource SWFieldStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <TextBlock x:Name="Placeholder"
                                               Text="{TemplateBinding Tag}"
                                               Foreground="{StaticResource BrushSubtle}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed"
                                               Margin="2,0,0,0" />
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Text" Value="" />
                                        <Condition Property="IsKeyboardFocused" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel>

        <!-- Blue accent stripe -->
        <Border Height="4" Background="{StaticResource BrushAccentBlue}" />

        <StackPanel Margin="16,14,16,16">

            <!-- Property Mappings title -->
            <TextBlock Text="Property Mappings"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource BrushForeground}"
                       Margin="0,0,0,4" />

            <!-- Subtitle -->
            <TextBlock Text="Map InvenTree part properties to your SolidWorks custom property names."
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap" />

            <!-- Column headers -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="InvenTree Part Property"
                           Style="{StaticResource ColumnHeaderStyle}"
                           HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="SolidWorks Document Property"
                           Style="{StaticResource ColumnHeaderStyle}"
                           HorizontalAlignment="Left" />
            </Grid>

            <!-- IPN row -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="IPN"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource MappingFieldStyle}"
                         Height="26"
                         Text="{Binding IpnProperty, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding IpnPlaceholder}"
                         />
            </Grid>

            <!-- Name row -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Name"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource MappingFieldStyle}"
                         Height="26"
                         Text="{Binding NameProperty, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding NamePlaceholder}"
                         />
            </Grid>

            <!-- Description row -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Description"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource MappingFieldStyle}"
                         Height="26"
                         Text="{Binding DescriptionProperty, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding DescriptionPlaceholder}"
                         />
            </Grid>

            <!-- Revision row -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Revision"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource MappingFieldStyle}"
                         Height="26"
                         Text="{Binding RevisionProperty, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding RevisionPlaceholder}"
                         />
            </Grid>

            <!-- Notes row -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Notes"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource MappingFieldStyle}"
                         Height="26"
                         Text="{Binding NotesProperty, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding NotesPlaceholder}"
                         />
            </Grid>

            <!-- InvenTree PK row -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="InvenTree PK"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource MappingFieldStyle}"
                         Height="26"
                         Text="{Binding PkProperty, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding PkPlaceholder}"
                         />
            </Grid>

            <!-- ── Separator ─────────────────────────────────────────────────── -->
            <Separator Background="{StaticResource BrushBorder}" Margin="0,8,0,0" />

            <!-- BOM Column Alias section -->
            <TextBlock Text="BOM Column Aliases"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource BrushForeground}"
                       Margin="0,8,0,4" />
            <TextBlock Text="Enter comma-separated SolidWorks BOM table column headers for each InvenTree field for assembly BOM comparison."
                       Style="{StaticResource FieldLabelStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4" />

            <!-- BOM Column headers -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="InvenTree BOM Field"
                           Style="{StaticResource ColumnHeaderStyle}"
                           HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="SolidWorks BOM Column"
                           Style="{StaticResource ColumnHeaderStyle}"
                           HorizontalAlignment="Left" />
            </Grid>

            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}"
                           ToolTip="BOM Compare needs this alias">
                    <Run Text="IPN" />
                    <Run Text="*" Foreground="{StaticResource BrushStatusWarning}" FontWeight="Bold" />
                </TextBlock>
                <TextBox Grid.Column="1"
                         Style="{StaticResource MappingFieldStyle}"
                         Height="26"
                         Text="{Binding BomColumnIpn, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding BomColumnIpnPlaceholder}"
                         />
            </Grid>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}"
                           ToolTip="BOM Compare needs this alias">
                    <Run Text="Qty" />
                    <Run Text="*" Foreground="{StaticResource BrushStatusWarning}" FontWeight="Bold" />
                </TextBlock>
                <TextBox Grid.Column="1"
                         Style="{StaticResource MappingFieldStyle}"
                         Height="26"
                         Text="{Binding BomColumnQty, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding BomColumnQtyPlaceholder}"
                         />
            </Grid>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Reference"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource MappingFieldStyle}"
                         Height="26"
                         Text="{Binding BomColumnReference, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding BomColumnReferencePlaceholder}"
                         />
            </Grid>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Note"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource MappingFieldStyle}"
                         Height="26"
                         Text="{Binding BomColumnNote, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding BomColumnNotePlaceholder}"
                         />
            </Grid>

            <!-- Status bar + buttons -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="StatusBar"
                        Grid.Column="0"
                        Height="32"
                        Background="#FFF0F0F0"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,1,0,0"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="StatusStripe" Grid.Column="0"
                                Background="{StaticResource BrushStatusNone}" />
                        <TextBox x:Name="StatusText"
                                 Grid.Column="1"
                                 Text="{Binding StatusMessage, Mode=OneWay}"
                                 ToolTip="{Binding StatusMessage, Mode=OneWay}"
                                 Style="{StaticResource StatusBarTextStyle}" />
                    </Grid>
                </Border>

                <Button x:Name="SaveButton"
                        Grid.Column="2"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="80" Margin="0"
                        IsDefault="True"
                        Click="Save_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Save" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="4"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="80" Margin="0"
                        IsCancel="True"
                        Click="Cancel_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cancel" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

        </StackPanel>
    </StackPanel>
</Window>
