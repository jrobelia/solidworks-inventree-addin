<Window
    x:Class="SwInventreeAddin.UI.PropertyMappingEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Property Field Mappings"
    Width="480"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="Manual"
    ShowInTaskbar="False"
    FontFamily="Segoe UI"
    FontSize="12">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel>

        <!-- Blue accent stripe -->
        <Border Height="4" Background="{StaticResource BrushAccentBlue}" />

        <StackPanel Margin="16,14,16,16">

            <!-- Subtitle -->
            <TextBlock Text="Map InvenTree part properties to your SolidWorks custom property names."
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap" />

            <!-- Read-only amber info bar (visible when provider.IsReadOnly) -->
            <Border x:Name="ReadOnlyBanner"
                    Visibility="Collapsed"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource BrushStatusWarning}" />
                    <Border Grid.Column="1" Background="#FFF8E1">
                        <TextBlock
                            Text="Loaded from a shared file — edit the source file directly to change mappings."
                            Margin="8,6,8,6"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource BrushForeground}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Column headers -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="InvenTree Part Property"
                           Style="{StaticResource ColumnHeaderStyle}"
                           HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="SolidWorks Custom Property"
                           Style="{StaticResource ColumnHeaderStyle}"
                           HorizontalAlignment="Left" />
            </Grid>

            <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,4" />

            <!-- IPN row -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="IPN"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox x:Name="IpnPropertyBox" Grid.Column="1"
                         Style="{StaticResource SWFieldStyle}" Height="26" />
            </Grid>

            <!-- Name row -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Name"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox x:Name="NamePropertyBox" Grid.Column="1"
                         Style="{StaticResource SWFieldStyle}" Height="26" />
            </Grid>

            <!-- Description row -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Description"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox x:Name="DescriptionPropertyBox" Grid.Column="1"
                         Style="{StaticResource SWFieldStyle}" Height="26" />
            </Grid>

            <!-- Revision row -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Revision"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox x:Name="RevisionPropertyBox" Grid.Column="1"
                         Style="{StaticResource SWFieldStyle}" Height="26" />
            </Grid>

            <!-- Notes row -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Notes"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox x:Name="NotesPropertyBox" Grid.Column="1"
                         Style="{StaticResource SWFieldStyle}" Height="26" />
            </Grid>

            <!-- InvenTree PK row -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="InvenTree PK"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushForeground}" />
                <TextBox x:Name="PkPropertyBox" Grid.Column="1"
                         Style="{StaticResource SWFieldStyle}" Height="26" />
            </Grid>

            <!-- Validation error (visible when duplicate names detected) -->
            <TextBlock x:Name="ErrorText"
                       Visibility="Collapsed"
                       Foreground="{StaticResource BrushStatusError}"
                       FontSize="{StaticResource FontSizeBody}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />

            <!-- Buttons -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SaveButton"
                        Grid.Column="1"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="80" Margin="0"
                        IsDefault="True"
                        Click="Save_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Save" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="80" Margin="0"
                        IsCancel="True"
                        Click="Cancel_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cancel" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

        </StackPanel>
    </StackPanel>
</Window>
