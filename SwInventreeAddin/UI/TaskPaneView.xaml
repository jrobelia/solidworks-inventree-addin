<UserControl
    x:Class="SwInventreeAddin.UI.TaskPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SwInventreeAddin.UI"
    FontFamily="Segoe UI"
    FontSize="12"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Visibility converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <local:ByteArrayToBitmapImageConverter x:Key="ThumbConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        Root DockPanel:
          Bottom = status bar (always visible, pinned to foot)
          Fill   = scrollable content area
    -->
    <DockPanel LastChildFill="True">

        <!-- ── Status bar ──────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" Height="32"
                Background="#FFF0F0F0"
                BorderBrush="#FFD0D0D0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Colour stripe - bound via code-behind to StatusSeverity -->
                <Border x:Name="StatusStripe" Grid.Column="0"
                        Background="{StaticResource BrushStatusNone}" />

                <!-- Severity icon - glyph and visibility set by code-behind -->
                <TextBlock x:Name="StatusIcon" Grid.Column="1"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="6,0,2,0"
                           Visibility="Collapsed"
                           Foreground="{StaticResource BrushStatusNone}" />

                <TextBlock Grid.Column="2"
                           Text="{Binding StatusText}"
                           Style="{StaticResource FieldLabelStyle}"
                           VerticalAlignment="Center"
                           Margin="4,0,4,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource BrushForeground}" />
            </Grid>
        </Border>

        <!-- ── Scrollable content ──────────────────────────────────────── -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{StaticResource PanelPadding}">

                <!-- Settings button -->
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Margin="0"
                        Click="Settings_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Settings" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>

                <!-- Part number label + entry -->
                <TextBlock Text="Part Number" Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="PartNumberBox"
                         Text="{Binding PartNumber, Mode=OneWay}"
                         Style="{StaticResource SWFieldStyle}"
                         IsReadOnly="True"
                         Focusable="False"
                         Height="26" />

                <!-- Load / Create button row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{Binding FetchEnabled}"
                            Click="Fetch_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Load Properties from InvenTree" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding CreatePartEnabled}"
                            ToolTip="Create a new part in InvenTree and write the IPN back to this document."
                            Click="CreatePart_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Create InvenTree P/N" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE710;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="5,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Separator -->
                <Separator Margin="0,8,0,0"
                           Background="#FFD7D7D7" />

                <!-- ── Properties comparison grid ─────────────────────── -->
                <StackPanel Visibility="{Binding PropertiesSectionVisible,
                                               Converter={StaticResource BoolToVis}}">

                    <!-- Section header: grey band + 3px blue left stripe -->
                    <Grid Margin="{StaticResource SectionSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource BrushAccentBlue}" />
                        <Border Grid.Column="1"
                                Background="{StaticResource BrushSectionHeader}"
                                Padding="6,4">
                            <TextBlock Text="Part Properties"
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeHeading}" />
                        </Border>
                    </Grid>

                    <!-- Column headers -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SolidWorks"
                                   Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="2" Text="InvenTree"
                                   Style="{StaticResource ColumnHeaderStyle}" />
                    </Grid>

                    <!-- Image row -->
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Push-image button on SW side: 50px tall, bottom of row -->
                        <Button Grid.Column="0"
                                Height="50"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource SecondaryButtonStyle}"
                                IsEnabled="{Binding PushImageVisible}"
                                Click="PushImage_Click">
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center">
                                <Run Text="Capture and Push Image to InvenTree " />
                                <Run Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" />
                            </TextBlock>
                        </Button>

                        <!-- Thumbnail on InvenTree side -->
                        <Border Grid.Column="2"
                                Width="120" Height="120"
                                HorizontalAlignment="Center"
                                CornerRadius="4"
                                Background="Transparent"
                                MouseLeftButtonUp="Thumbnail_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="2" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                    <Setter Property="ToolTip" Value="{x:Null}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PartLinkEnabled}" Value="True">
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="ToolTip" Value="View in InvenTree" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding PartLinkEnabled}" Value="True" />
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushAccentBlue}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <!-- Grey placeholder box (always visible) -->
                                <Border Background="#FFE0E0E0" CornerRadius="4" />
                                <!-- No-image icon (only when InvenTree data loaded but no thumbnail) -->
                                <TextBlock Text="&#x1F5BC;"
                                           FontSize="36"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#FF888888"
                                           Visibility="{Binding PushImageVisible, Converter={StaticResource BoolToVis}}" />
                                <!-- Actual thumbnail paints over placeholder when loaded -->
                                <Image Source="{Binding ThumbnailBytes, Converter={StaticResource ThumbConverter}}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <!-- Link affordance -->
                                <TextBlock Text="&#xE71B;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="White"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,4,4"
                                           Visibility="{Binding PartLinkEnabled, Converter={StaticResource BoolToVis}}">
                                    <TextBlock.Effect>
                                        <DropShadowEffect ShadowDepth="0"
                                                          BlurRadius="3"
                                                          Color="Black"
                                                          Opacity="0.8" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                    <TextBlock Text="Name"
                               Style="{StaticResource FieldLabelStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox Grid.Column="0" Grid.Row="0"
                                 Text="{Binding CurrentName, Mode=OneWay}"
                                 ToolTip="{Binding CurrentName}"
                                 Style="{StaticResource SWFieldStyle}"
                                 IsReadOnly="True"
                                 Focusable="False"
                                 Height="26" />

                        <!-- Match indicator -->
                        <TextBlock Grid.Column="1" Grid.Row="0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="14" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="" />
                                    <Setter Property="Foreground" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NameMatch}" Value="True">
                                            <Setter Property="Text" Value="=" />
                                            <Setter Property="Foreground" Value="#FF2E7D32" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NameMatch}" Value="False">
                                            <Setter Property="Text" Value="&#x2260;" />
                                            <Setter Property="Foreground" Value="#FFF9A825" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox Grid.Column="2" Grid.Row="0"
                                 Text="{Binding NamePreview, Mode=OneWay}"
                                 ToolTip="{Binding NamePreview}"
                                 Style="{StaticResource InvenTreeFieldStyle}"
                                 Height="26" />
                        <Button Grid.Column="0" Grid.Row="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding PushNameEnabled}"
                                Click="PushName_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Push to InvenTree" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Grid.Row="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding ApplyNameEnabled}"
                                Click="ApplyName_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="Apply to SW Doc" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Description row -->
                    <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox Grid.Column="0" Grid.Row="0"
                                 Text="{Binding CurrentDescription, Mode=OneWay}"
                                 ToolTip="{Binding CurrentDescription}"
                                 Style="{StaticResource SWFieldStyle}"
                                 IsReadOnly="True"
                                 Focusable="False"
                                 Height="26" />

                        <!-- Match indicator -->
                        <TextBlock Grid.Column="1" Grid.Row="0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="14" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="" />
                                    <Setter Property="Foreground" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DescriptionMatch}" Value="True">
                                            <Setter Property="Text" Value="=" />
                                            <Setter Property="Foreground" Value="#FF2E7D32" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DescriptionMatch}" Value="False">
                                            <Setter Property="Text" Value="&#x2260;" />
                                            <Setter Property="Foreground" Value="#FFF9A825" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox Grid.Column="2" Grid.Row="0"
                                 Text="{Binding DescriptionPreview, Mode=OneWay}"
                                 ToolTip="{Binding DescriptionPreview}"
                                 Style="{StaticResource InvenTreeFieldStyle}"
                                 Height="26" />
                        <Button Grid.Column="0" Grid.Row="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding PushDescriptionEnabled}"
                                Click="PushDescription_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Push to InvenTree" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Grid.Row="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding ApplyDescriptionEnabled}"
                                Click="ApplyDescription_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="Apply to SW Doc" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Notes row -->
                    <TextBlock Text="Notes" Style="{StaticResource FieldLabelStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox Grid.Column="0" Grid.Row="0"
                                 Text="{Binding CurrentNotes, Mode=OneWay}"
                                 ToolTip="{Binding CurrentNotes}"
                                 Style="{StaticResource SWFieldStyle}"
                                 IsReadOnly="True"
                                 Focusable="False"
                                 Height="52"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" />

                        <!-- Match indicator -->
                        <TextBlock Grid.Column="1" Grid.Row="0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="14" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="" />
                                    <Setter Property="Foreground" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NotesMatch}" Value="True">
                                            <Setter Property="Text" Value="=" />
                                            <Setter Property="Foreground" Value="#FF2E7D32" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NotesMatch}" Value="False">
                                            <Setter Property="Text" Value="&#x2260;" />
                                            <Setter Property="Foreground" Value="#FFF9A825" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox Grid.Column="2" Grid.Row="0"
                                 Text="{Binding NotesPreview, Mode=OneWay}"
                                 ToolTip="{Binding NotesPreview}"
                                 Style="{StaticResource InvenTreeFieldStyle}"
                                 Height="52"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" />
                        <Button Grid.Column="0" Grid.Row="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding PushNotesEnabled}"
                                Click="PushNotes_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Push to InvenTree" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Grid.Row="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding ApplyNotesEnabled}"
                                Click="ApplyNotes_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="Apply to SW Doc" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Revision row (read-only both sides) -->
                    <TextBlock Text="Revision" Style="{StaticResource FieldLabelStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding CurrentRevision, Mode=OneWay}"
                                 Style="{StaticResource SWFieldStyle}"
                                 IsReadOnly="True"
                                 Focusable="False"
                                 Height="26" />

                        <!-- Match indicator -->
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="14" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="" />
                                    <Setter Property="Foreground" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RevisionMatch}" Value="True">
                                            <Setter Property="Text" Value="=" />
                                            <Setter Property="Foreground" Value="#FF2E7D32" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RevisionMatch}" Value="False">
                                            <Setter Property="Text" Value="&#x2260;" />
                                            <Setter Property="Foreground" Value="#FFF9A825" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox Grid.Column="2"
                                 Text="{Binding RevisionPreview, Mode=OneWay}"
                                 Style="{StaticResource InvenTreeFieldStyle}"
                                 IsReadOnly="True"
                                 Height="26" />
                    </Grid>

                    <!-- Push Revision button (SW side only) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding PushRevisionVisible}"
                                Click="PushRevision_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Push to InvenTree" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- InvenTree PK row (display + Apply to SW Doc) -->
                    <TextBlock Text="InvenTree PK" Style="{StaticResource FieldLabelStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox Grid.Column="0" Grid.Row="0"
                                 Text="{Binding CurrentPk, Mode=OneWay}"
                                 ToolTip="{Binding CurrentPk}"
                                 Style="{StaticResource SWFieldStyle}"
                                 IsReadOnly="True"
                                 Focusable="False"
                                 Height="26" />

                        <!-- Match indicator -->
                        <TextBlock Grid.Column="1" Grid.Row="0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="14" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="" />
                                    <Setter Property="Foreground" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PkMatch}" Value="True">
                                            <Setter Property="Text" Value="=" />
                                            <Setter Property="Foreground" Value="#FF2E7D32" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PkMatch}" Value="False">
                                            <Setter Property="Text" Value="&#x2260;" />
                                            <Setter Property="Foreground" Value="#FFF9A825" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox Grid.Column="2" Grid.Row="0"
                                 Text="{Binding PkPreview, Mode=OneWay}"
                                 ToolTip="{Binding PkPreview}"
                                 Style="{StaticResource InvenTreeFieldStyle}"
                                 IsReadOnly="True"
                                 Height="26" />
                        <Button Grid.Column="2" Grid.Row="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding ApplyPkEnabled}"
                                Click="ApplyPk_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="Apply to SW Doc" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                </StackPanel>
                <!-- end properties section -->

                <!-- ── InvenTree info panel (read-only stock/status) ──────────── -->
                <StackPanel Visibility="{Binding PropertiesSectionVisible,
                                         Converter={StaticResource BoolToVis}}"
                            Margin="0,8,0,0">

                    <Grid Margin="{StaticResource SectionSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource BrushAccentBlue}" />
                        <Border Grid.Column="1"
                                Background="{StaticResource BrushSectionHeader}"
                                Padding="6,4">
                            <TextBlock Text="InvenTree Info"
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeHeading}" />
                        </Border>
                    </Grid>

                    <!-- In Stock row -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="In Stock"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding InStockDisplay, Mode=OneWay}"
                                 Style="{StaticResource InvenTreeFieldStyle}"
                                 IsReadOnly="True" Height="26" />
                    </Grid>

                    <!-- Ordering row -->
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="On Order"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding OrderingDisplay, Mode=OneWay}"
                                 Style="{StaticResource InvenTreeFieldStyle}"
                                 IsReadOnly="True" Height="26" />
                    </Grid>

                    <!-- Status row -->
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Status"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding ActiveDisplay, Mode=OneWay}"
                                 Style="{StaticResource InvenTreeFieldStyle}"
                                 IsReadOnly="True" Height="26" />
                    </Grid>

                </StackPanel>
                <!-- end InvenTree info panel -->

                <!-- ── BOM Comparison section ────────────────────────────── -->
                <StackPanel Visibility="{Binding BomSectionVisible,
                                         Converter={StaticResource BoolToVis}}"
                            Margin="0,8,0,0">

                    <Grid Margin="{StaticResource SectionSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource BrushAccentBlue}" />
                        <Border Grid.Column="1"
                                Background="{StaticResource BrushSectionHeader}"
                                Padding="6,4">
                            <TextBlock Text="BOM Comparison"
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeHeading}" />
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding BomStatusText}"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,4,0,4" />

                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{Binding BomButtonEnabled}"
                            Click="CompareBom_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Compare BOM Table with InvenTree" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
