<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWpf>true</UseWpf>
    <RootNamespace>SwInventreeAddin</RootNamespace>
    <AssemblyName>SwInventreeAddin</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <!-- SolidWorks API interop DLLs.
         Private=False: not copied to output; SolidWorks provides them at runtime.
         EmbedInteropTypes=True: COM interface definitions baked into our DLL at compile time,
         making the built package version-independent (works on SW2022 through SW2026+).
         Path auto-detected via Directory.Build.props. -->
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksApiRedist)\SolidWorks.Interop.sldworks.dll</HintPath>
      <Private>False</Private>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksApiRedist)\SolidWorks.Interop.swconst.dll</HintPath>
      <Private>False</Private>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SolidWorksApiRedist)\SolidWorks.Interop.swpublished.dll</HintPath>
      <Private>False</Private>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\inventree_icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Derive the assembly version from the nearest git tag and the number of
    commits since that tag. For example, v2.0.0-107-gce8b2dc becomes 2.0.0.107.
  -->
  <Target Name="SetGitVersion" BeforeTargets="GetAssemblyVersion">
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)SetGitVersion.ps1&quot;" ConsoleToMsBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitAssemblyVersion" />
    </Exec>
    <PropertyGroup>
      <Version>$(GitAssemblyVersion.Trim())</Version>
      <AssemblyVersion>$(GitAssemblyVersion.Trim())</AssemblyVersion>
      <FileVersion>$(GitAssemblyVersion.Trim())</FileVersion>
    </PropertyGroup>
  </Target>
</Project>
