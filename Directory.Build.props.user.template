<Project>
  <!--
    OPTIONAL: Only needed if auto-detection in Directory.Build.props fails,
    or if you want to force a specific SolidWorks version.

    Copy this file to Directory.Build.props.user (gitignored) and set your path.

    To find your path: search C:\Program Files for SolidWorks.Interop.sldworks.dll
    and use the 'api\redist' folder that contains it.
  -->
  <PropertyGroup>
    <SolidWorksApiRedist>C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SolidWorksApiRedist>
  </PropertyGroup>
</Project>
