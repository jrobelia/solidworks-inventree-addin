@startuml architecture_diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()
title Component diagram for the SolidWorks InvenTree Add-In (post-ADR-0025)

Person(engineer, "Design Engineer", "Uses SolidWorks and wants to keep part data in sync with InvenTree.")

Container_Boundary(addin, "SolidWorks InvenTree Add-In (C# .NET 4.8 COM Add-in)") {
    Component(swAddin, "SwAddin", "C# / .NET Framework 4.8", "COM entry point and lifecycle. Handles RegAsm registration, guarded SolidWorks event subscriptions, TLS setup, and assembly resolution.")
    Component(taskPaneControl, "TaskPaneControl", "WinForms / ElementHost", "Composition root and host adapter: builds the coordinator, STA dispatcher, readiness context, and ViewModel; routes SolidWorks host callbacks into the coordinator and hands results to the ViewModel's projection entries.")
    Component(taskPaneView, "TaskPaneView", "WPF / XAML", "MVVM view bound to TaskPaneViewModel; displays part comparison, status, thumbnail link, and BOM actions.")
    Component(taskPaneVM, "TaskPaneViewModel", "C# / INotifyPropertyChanged", "Projection adapter over IPartSyncCoordinator: bindable properties, status wording, and confirmation prompts. Owns no session state and issues no document writes.")
    Component(iPartSyncCoord, "IPartSyncCoordinator", "interface", "The approved public Part Sync seam: read-only session/document surface, Changed event, document-lifecycle notifications, and Fetch/Create/Apply/Push/Resume operations returning typed PartSyncResult outcomes.")
    Component(partSyncCoord, "PartSyncCoordinator", "C# Domain Logic", "Single owner of the Part Sync session: operation tokens, pending-write echoes, pending confirmations. STA capture -> off-thread network/image work -> commit marshalled through IHostStaDispatcher with token revalidation inside the commit.")
    Component(taskPaneState, "TaskPaneState", "C#", "State only: the active document snapshot, document generation, and the Populated marker. Owned by the coordinator.")
    Component(partSync, "PartSyncSession", "C# Domain Logic (coordinator-internal)", "The fetched InvenTree part plus field-level Apply (InvenTree -> SW) and Push (SW -> InvenTree); PartSyncFields owns the per-field property-name/value/commit table. Only the coordinator creates or clears it.")
    Component(staDispatcher, "IHostStaDispatcher", "interface", "STA marshalling seam every coordinator commit crosses.")
    Component(syncStaDispatcher, "SynchronizationContextStaDispatcher", "C#", "Production adapter: captures the host STA SynchronizationContext; managed-thread-id check per ADR-0002.")
    Component(stubStaDispatcher, "StubHostStaDispatcher", "C# (test project)", "Test adapter: runs inline, with a queued-commit mode that parks commits so tests can land a document switch mid-flight.")
    Component(iBomReadinessCtx, "IBomReadinessContext", "interface", "Narrow BOM readiness seam: snapshot capture plus the explicit push-revision command.")
    Component(bomCtx, "CoordinatorBomReadinessContext", "C#", "Production adapter over the concrete coordinator (internal light refresh); marshals snapshot captures through the dispatcher.")
    Component(bomSnapshot, "BomReadinessSnapshot", "C# (immutable)", "One coherent readiness snapshot consumed by the pre-flight check.")
    Component(createPartVM, "CreatePartViewModel", "C# / WPF", "Workflow logic for creating a new InvenTree part: category tree navigation, duplicate-IPN guard, optional polling for server-assigned IPN. The coordinator's CompleteCreatePart performs the stale-validated stamping commit.")
    Component(createPartWin, "CreatePartWindow", "WPF", "Dialog for creating a new InvenTree part.")
    Component(bomCompareVM, "BomCompareViewModel", "C# / INotifyPropertyChanged", "ViewModel for the BOM compare dialog; loads SW and InvenTree BOMs, runs the diff engine, and pushes selected lines to InvenTree.")
    Component(bomCompareWin, "BomCompareWindow", "WPF / XAML", "Dialog that displays the BOM diff and lets the user select which lines to push.")
    Component(inventreeClient, "InventreeHttpClient", "System.Net.Http / System.Text.Json", "REST client for InvenTree endpoints: parts, BOM, categories, images, server info, and public part-detail URL construction.")
    Component(bomReadiness, "BomCompareReadinessCheck", "C#", "Pre-flight validation of PK linkage and revision alignment before a BOM compare; evaluates the existing session snapshot only, never fetches.")
    Component(bomDiff, "BomDiffEngine", "C#", "Compares SolidWorks assembly BOM against the InvenTree BOM and classifies lines as matched, new, changed, ambiguous, or InvenTree-only.")
    Component(revCompare, "RevisionComparer", "C#", "Determines whether SolidWorks or InvenTree has the newer revision and detects ambiguous/unknown ordering.")
    Component(imagePipeline, "ImagePipeline", "System.Drawing", "Crops, resizes, and PNG-encodes viewport captures for the image push.")
    Component(configProvider, "EncryptedConfigProvider", "Windows DPAPI", "Encrypts and stores the InvenTree server URL and API key under %APPDATA%.")
    Component(mappingProvider, "PropertyMappingProvider", "JSON file / network share", "Provides user-configurable mapping between SolidWorks custom property names and InvenTree fields/BOM columns.")
    Component(swDocProp, "SwDocumentPropertyService", "SolidWorks.Interop", "Reads and writes SolidWorks custom properties and BOM tables via COM interop.")
    Component(swViewport, "SwViewportCaptureService", "SolidWorks.Interop", "Captures viewport screenshots from the active SolidWorks model view.")
    Component(settingsWin, "SettingsWindow", "WPF", "UI for configuring server credentials, selecting mapping source, and editing property mapping.")
}

System_Ext(solidworks, "SolidWorks", "Dassault Systemes SolidWorks CAD application that hosts the COM add-in.")
System_Ext(inventree, "InvenTree", "Open-source PLM/ERP inventory server exposed via HTTPS REST API.")

Rel(engineer, solidworks, "Opens parts/assemblies and uses the InvenTree task pane")
Rel(solidworks, swAddin, "Loads via COM and dispatches application/document events")
Rel(swAddin, taskPaneControl, "Creates and adds to the SolidWorks task pane; routes host callbacks")
Rel(taskPaneControl, taskPaneView, "Hosts WPF view with ElementHost")
Rel(taskPaneView, taskPaneVM, "Data binding (MVVM)")

Rel(taskPaneControl, partSyncCoord, "Builds and drives the document lifecycle")
Rel(taskPaneControl, syncStaDispatcher, "Creates (captures the host STA context)")
Rel(taskPaneControl, bomCtx, "Builds the readiness context")
Rel(taskPaneControl, swViewport, "Wires viewport capture + crop dialog (host seam)")

Rel(taskPaneVM, iPartSyncCoord, "Projects the surface; routes Fetch/Apply/Push commands")
Rel(partSyncCoord, iPartSyncCoord, "Implements")
Rel(taskPaneVM, inventreeClient, "Composes Create Part / BOM dialog ViewModels over the client")
Rel(taskPaneVM, createPartVM, "Triggers new-part creation flow")
Rel(createPartVM, createPartWin, "Dialog binding")
Rel(createPartVM, inventreeClient, "Creates parts and checks duplicate IPNs")

Rel(partSyncCoord, taskPaneState, "Owns document state and generation")
Rel(partSyncCoord, partSync, "Installs/drops the session")
Rel(partSyncCoord, staDispatcher, "Marshals every commit onto the STA thread")
Rel(partSyncCoord, swDocProp, "Captures document snapshots; registers write echoes")
Rel(partSyncCoord, inventreeClient, "Fetches parts, pushes fields, uploads image, re-downloads thumbnail")
Rel(partSyncCoord, imagePipeline, "Crops/encodes the push image to PNG")
Rel(partSyncCoord, mappingProvider, "Resolves the property mapping")
Rel(partSync, swDocProp, "Reads/writes mapped Document Properties")
Rel(syncStaDispatcher, staDispatcher, "Production adapter")
Rel(stubStaDispatcher, staDispatcher, "Test adapter")

Rel(taskPaneVM, bomReadiness, "Builds the pre-flight check")
Rel(bomReadiness, iBomReadinessCtx, "Evaluates the readiness snapshot")
Rel(bomCtx, iBomReadinessCtx, "Implements")
Rel(bomCtx, bomSnapshot, "Produces")
Rel(bomCtx, partSyncCoord, "Captures via the concrete coordinator (internal light refresh)")
Rel(bomCtx, staDispatcher, "Marshals snapshot captures")
Rel(taskPaneVM, bomCompareVM, "Opens BOM compare dialog")
Rel(bomCompareVM, bomCompareWin, "Dialog binding")
Rel(bomCompareVM, swDocProp, "Reads SW BOM table and resolves sub-assembly IPNs")
Rel(bomCompareVM, inventreeClient, "Fetches InvenTree BOM and pushes selected lines")
Rel(bomCompareVM, bomDiff, "Runs diff between SW and InvenTree BOMs")
Rel(bomDiff, revCompare, "Resolves duplicate IPNs by revision match")

Rel(swViewport, solidworks, "Captures viewport via SolidWorks API")
Rel(swDocProp, solidworks, "Reads/writes custom properties and BOM tables via COM")
Rel(inventreeClient, inventree, "HTTPS REST calls authenticated with API token")

Rel(taskPaneVM, configProvider, "Reads encrypted server config and credentials")
Rel(inventreeClient, configProvider, "Obtains API key and base URL")
Rel(taskPaneVM, mappingProvider, "Reads property/BOM column mappings")
Rel(settingsWin, configProvider, "Reads/writes encrypted credentials")
Rel(settingsWin, mappingProvider, "Reads/writes property mapping source")

@enduml
